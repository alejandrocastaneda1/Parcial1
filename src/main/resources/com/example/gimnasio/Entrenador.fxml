<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gimnasio.viewController.EntrenadorViewController"
            prefWidth="1200"
            prefHeight="720"
            style="-fx-background-color: #F7F1E5;">

    <!-- BARRA LATERAL -->
    <left>

        <VBox prefWidth="220"
              spacing="15"
              style="-fx-background-color: #171717;"
              alignment="TOP_CENTER">

            <padding>
                <Insets top="30" right="15" bottom="25" left="15"/>
            </padding>

            <Label text="SMARTGYM"
                   style="-fx-text-fill: #D6A84F;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="GESTIÓN"
                   style="-fx-text-fill: #888888;
                          -fx-font-size: 11px;"/>

            <Button text="⌂   Inicio"
                    onAction="#abrirInicio"
                    prefWidth="185"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="♙   Clientes"
                    onAction="#abrirClientes"
                    prefWidth="185"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="★   Entrenadores"
                    prefWidth="185"
                    style="-fx-background-color: #D6A84F;
                           -fx-text-fill: #171717;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-background-radius: 8;"/>

            <Button text="▣   Planes"
                    onAction="#abrirPlanes"
                    prefWidth="185"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="◆   Beneficios"
                    onAction="#abrirBeneficios"
                    prefWidth="185"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-alignment: CENTER_LEFT;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="SMARTGYM 2026"
                   style="-fx-text-fill: #666666;
                          -fx-font-size: 11px;"/>

        </VBox>

    </left>


    <!-- CONTENIDO PRINCIPAL -->
    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="35" right="40" bottom="35" left="40"/>
            </padding>


            <!-- ENCABEZADO -->

            <VBox spacing="5">

                <Label text="Gestionar entrenadores"
                       style="-fx-text-fill: #222222;
                              -fx-font-size: 30px;
                              -fx-font-weight: bold;"/>

                <Label text="Administra los entrenadores y sus tarifas por sesión."
                       style="-fx-text-fill: #777777;
                              -fx-font-size: 14px;"/>

            </VBox>


            <!-- FORMULARIO -->

            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #E5DED1;
                         -fx-border-radius: 12;">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Información del entrenador"
                       style="-fx-text-fill: #333333;
                              -fx-font-size: 17px;
                              -fx-font-weight: bold;"/>


                <GridPane hgap="15" vgap="10">

                    <Label text="Identificación"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"
                           style="-fx-text-fill: #555555;"/>

                    <TextField fx:id="txtIdentificacion"
                               promptText="Ej: ENT-004"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"
                               prefWidth="250"/>


                    <Label text="Nombre"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"
                           style="-fx-text-fill: #555555;"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre completo"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"
                               prefWidth="250"/>


                    <Label text="Especialidad"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"
                           style="-fx-text-fill: #555555;"/>

                    <TextField fx:id="txtEspecialidad"
                               promptText="Ej: Musculación"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"
                               prefWidth="250"/>


                    <Label text="Teléfono"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"
                           style="-fx-text-fill: #555555;"/>

                    <TextField fx:id="txtTelefono"
                               promptText="Número de teléfono"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1"
                               prefWidth="250"/>


                    <Label text="Tarifa por sesión"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"
                           style="-fx-text-fill: #555555;"/>

                    <TextField fx:id="txtTarifa"
                               promptText="Ej: 35000"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"
                               prefWidth="250"/>

                </GridPane>


                <!-- BOTONES -->

                <HBox spacing="10">

                    <Button text="＋ Crear entrenador"
                            onAction="#crearEntrenador"
                            style="-fx-background-color: #D6A84F;
                                   -fx-text-fill: #171717;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 7;
                                   -fx-padding: 9 18;"/>

                    <Button text="Cargar seleccionado"
                            onAction="#cargarEntrenador"
                            style="-fx-background-color: #333333;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-padding: 9 18;"/>

                    <Button text="Eliminar"
                            onAction="#eliminarEntrenador"
                            style="-fx-background-color: #8B3A3A;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-padding: 9 18;"/>

                    <Button text="Limpiar"
                            onAction="#limpiar"
                            style="-fx-background-color: #E8E1D5;
                                   -fx-text-fill: #333333;
                                   -fx-background-radius: 7;
                                   -fx-padding: 9 18;"/>

                </HBox>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Entrenadores registrados"
                       style="-fx-text-fill: #333333;
                              -fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <TableView fx:id="tablaEntrenadores"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colIdentificacion"
                                     text="Identificación"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="190"/>

                        <TableColumn fx:id="colEspecialidad"
                                     text="Especialidad"
                                     prefWidth="210"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colTarifa"
                                     text="Tarifa / sesión"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>